# ---- Database ----
POSTGRES_USER=petrocore
POSTGRES_PASSWORD=petrocore
POSTGRES_DB=petrocore
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://petrocore:petrocore@db:5432/petrocore

# ---- API ----
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480
ENVIRONMENT=development
API_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Redis / workers ----
REDIS_URL=redis://redis:6379/0

# ---- AI gateway (LiteLLM-style; model swappable) ----
# Underlying model is swappable: claude / deepseek / etc.
AI_GATEWAY_URL=http://ai-gateway:9000
AI_MODEL=claude-opus-4-8
AI_API_KEY=
# Confidence threshold below which a result routes to human review (0-1)
CONFIDENCE_REVIEW_THRESHOLD=0.75

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_DEFAULT_LOCALE=ar
